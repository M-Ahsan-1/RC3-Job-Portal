# Server
PORT=3000
NODE_ENV=development

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=rc3_job_portal

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Gemini (resume parsing, matching, explanations)
GEMINI_API_KEY=your_gemini_api_key_here

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

CORS_ORIGINS=
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MIN=15
AUTH_RATE_LIMIT_MAX=20
JSON_LIMIT=100kb
TRUST_PROXY=
CSP_OFF=false
